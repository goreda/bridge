{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outline measurements v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reference_font_sha256",
    "candidate_font_sha256",
    "upm",
    "params",
    "method",
    "scope",
    "n_a_count",
    "glyphs",
    "n_a_by_class"
  ],
  "properties": {
    "schema": {
      "const": "kni.vector-measurements.v3"
    },
    "reference_font_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_font_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "upm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid",
        "margin"
      ],
      "properties": {
        "grid": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "method": {
      "const": "merged-flattened-area-sampled-hausdorff-v2"
    },
    "scope": {
      "const": "outlines-only"
    },
    "n_a_count": {
      "type": "integer",
      "minimum": 0
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codepoint",
              "path_label",
              "symmetric_difference_area",
              "area_floor",
              "hausdorff",
              "distance_floor"
            ],
            "properties": {
              "codepoint": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1114111
              },
              "path_label": {
                "const": "vector"
              },
              "symmetric_difference_area": {
                "type": "number",
                "minimum": 0
              },
              "area_floor": {
                "type": "number",
                "minimum": 0
              },
              "hausdorff": {
                "type": "number",
                "minimum": 0
              },
              "distance_floor": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codepoint",
              "status",
              "reason",
              "reason_class",
              "font"
            ],
            "properties": {
              "codepoint": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1114111
              },
              "status": {
                "const": "n/a"
              },
              "reason": {
                "enum": [
                  "candidate_missing",
                  "candidate_empty",
                  "reference_missing",
                  "reference_empty",
                  "outline_nonfinite",
                  "reader_truncated",
                  "reader_signature",
                  "reader_missing_table",
                  "reader_unsupported",
                  "reader_bad_charstring",
                  "reader_bad_glyf",
                  "reader_glyph_index",
                  "reader_budget",
                  "measurement_pitch",
                  "measurement_budget",
                  "measurement_empty",
                  "metric_nonfinite"
                ]
              },
              "reason_class": {
                "enum": [
                  "reference_unmeasurable",
                  "candidate_missing_or_empty",
                  "measurement_error"
                ]
              },
              "font": {
                "enum": [
                  "reference",
                  "candidate",
                  "both"
                ]
              }
            }
          }
        ]
      }
    },
    "n_a_by_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_unmeasurable",
        "candidate_missing_or_empty",
        "measurement_error"
      ],
      "properties": {
        "reference_unmeasurable": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_missing_or_empty": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_error": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
