{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kni.vector-input-manifest.v1",
  "title": "Vector sweep input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reference_font_sha256", "codepoints"],
  "properties": {
    "schema": {"const": "kni.vector-input-manifest.v1"},
    "reference_font_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codepoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "integer", "minimum": 0, "maximum": 1114111},
          {"type": "string", "pattern": "^(U\\+)?[0-9A-Fa-f]{1,6}$"}
        ]
      }
    }
  }
}
