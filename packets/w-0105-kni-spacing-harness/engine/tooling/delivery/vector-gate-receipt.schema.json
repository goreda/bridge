{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kni.vector-delivery-gate.v1",
  "title": "Vector fidelity delivery gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_font_sha256", "status", "glyphs", "table_rows"],
  "properties": {
    "schema": {"const": "kni.vector-delivery-gate.v1"},
    "source_font_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "PASS"},
    "glyphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codepoint", "path_label", "symmetric_difference_area", "area_floor", "hausdorff", "distance_floor"],
        "properties": {
          "codepoint": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1114111}, {"type": "string", "pattern": "^(U\\+)?[0-9A-Fa-f]{1,6}$"}]},
          "path_label": {"const": "vector"},
          "symmetric_difference_area": {"type": "number", "minimum": 0},
          "area_floor": {"type": "number", "minimum": 0},
          "hausdorff": {"type": "number", "minimum": 0},
          "distance_floor": {"type": "number", "minimum": 0}
        }
      }
    },
    "table_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codepoint", "path_label", "metric", "value", "limit", "unit", "pass"],
        "properties": {
          "codepoint": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1114111}, {"type": "string", "pattern": "^(U\\+)?[0-9A-Fa-f]{1,6}$"}]},
          "path_label": {"const": "vector"},
          "metric": {"enum": ["symmetric_difference_area", "hausdorff"]},
          "value": {"type": "number", "minimum": 0},
          "limit": {"type": "number", "minimum": 0},
          "unit": {"enum": ["unit^2", "units"]},
          "pass": {"type": "boolean"}
        }
      }
    }
  }
}
