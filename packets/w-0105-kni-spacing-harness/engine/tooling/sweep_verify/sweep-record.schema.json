{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Descriptive sweep integrity record",
  "description": "A strict JSON projection of one sweepaudit receipt. Lists and counts only. complete is a descriptive flag computed from those lists, not a decision gate. Compatibility with the real sweep writer is UNVERIFIED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "threshold_policy",
    "sweep_compatibility",
    "receipt_version",
    "receipt_sha256",
    "expected_list_sha256",
    "counts",
    "lists",
    "complete",
    "config_sha256"
  ],
  "properties": {
    "mode": {
      "const": "DESCRIPTIVE ONLY",
      "x-source": "descriptive_report summary.json"
    },
    "threshold_policy": {
      "const": "NONE; no decision gate"
    },
    "sweep_compatibility": {
      "const": "UNVERIFIED; adapter over the listing and examples supplied for the sweep"
    },
    "receipt_version": {
      "const": "sweepaudit-receipt-v1",
      "x-source": "sweepaudit core RECEIPT_VERSION"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256",
      "x-source": "sha256 of the receipt text as written"
    },
    "expected_list_sha256": {
      "$ref": "#/$defs/sha256",
      "x-source": "sha256 of the expected key list text"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_keys",
        "files_total",
        "one_result",
        "one_refusal",
        "tsv_skipped_hash_lines",
        "keyed",
        "unkeyed",
        "symlinks",
        "tsv_anomalies",
        "pattern_timeouts",
        "unmatched_exceptions",
        "sweep_level",
        "unreadable_files"
      ],
      "properties": {
        "expected_keys": {
          "type": "integer",
          "minimum": 0
        },
        "files_total": {
          "type": "integer",
          "minimum": 0
        },
        "one_result": {
          "type": "integer",
          "minimum": 0
        },
        "one_refusal": {
          "type": "integer",
          "minimum": 0
        },
        "tsv_skipped_hash_lines": {
          "type": "integer",
          "minimum": 0
        },
        "keyed": {
          "type": "integer",
          "minimum": 0
        },
        "unkeyed": {
          "type": "integer",
          "minimum": 0
        },
        "symlinks": {
          "type": "integer",
          "minimum": 0
        },
        "tsv_anomalies": {
          "type": "integer",
          "minimum": 0
        },
        "pattern_timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_exceptions": {
          "type": "integer",
          "minimum": 0
        },
        "sweep_level": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "doubled",
        "conflict",
        "unclassified",
        "unexpected",
        "unkeyed",
        "empty",
        "unreadable",
        "changed",
        "required_missing",
        "pair_differ",
        "pair_b_missing",
        "pair_b_without_a",
        "unexpected_files",
        "symlinks",
        "truncated",
        "tsv_anomalies",
        "unmatched_exceptions",
        "pattern_timeout",
        "sweep_level"
      ],
      "properties": {
        "missing": {
          "$ref": "#/$defs/strings"
        },
        "doubled": {
          "$ref": "#/$defs/strings"
        },
        "conflict": {
          "$ref": "#/$defs/strings"
        },
        "unclassified": {
          "$ref": "#/$defs/strings"
        },
        "unexpected": {
          "$ref": "#/$defs/strings"
        },
        "unkeyed": {
          "$ref": "#/$defs/strings"
        },
        "empty": {
          "$ref": "#/$defs/strings"
        },
        "unreadable": {
          "$ref": "#/$defs/strings"
        },
        "changed": {
          "$ref": "#/$defs/strings"
        },
        "required_missing": {
          "$ref": "#/$defs/strings"
        },
        "pair_differ": {
          "$ref": "#/$defs/strings"
        },
        "pair_b_missing": {
          "$ref": "#/$defs/strings"
        },
        "pair_b_without_a": {
          "$ref": "#/$defs/strings"
        },
        "unexpected_files": {
          "$ref": "#/$defs/strings"
        },
        "symlinks": {
          "$ref": "#/$defs/strings"
        },
        "truncated": {
          "$ref": "#/$defs/strings"
        },
        "tsv_anomalies": {
          "$ref": "#/$defs/strings"
        },
        "unmatched_exceptions": {
          "$ref": "#/$defs/strings"
        },
        "pattern_timeout": {
          "$ref": "#/$defs/strings"
        },
        "sweep_level": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "complete": {
      "type": "boolean",
      "description": "true only when every list that flags a problem is empty and every expected key has one record file"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256",
      "x-source": "sha256 of the canonical JSON of the effective sweepaudit config"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "lists": {
            "properties": {
              "missing": {
                "maxItems": 0
              },
              "doubled": {
                "maxItems": 0
              },
              "conflict": {
                "maxItems": 0
              },
              "unclassified": {
                "maxItems": 0
              },
              "unexpected": {
                "maxItems": 0
              },
              "unkeyed": {
                "maxItems": 0
              },
              "unreadable": {
                "maxItems": 0
              },
              "changed": {
                "maxItems": 0
              },
              "required_missing": {
                "maxItems": 0
              },
              "pair_differ": {
                "maxItems": 0
              },
              "pair_b_missing": {
                "maxItems": 0
              },
              "pair_b_without_a": {
                "maxItems": 0
              },
              "unexpected_files": {
                "maxItems": 0
              },
              "symlinks": {
                "maxItems": 0
              },
              "truncated": {
                "maxItems": 0
              },
              "empty": {
                "maxItems": 0
              },
              "tsv_anomalies": {
                "maxItems": 0
              },
              "unmatched_exceptions": {
                "maxItems": 0
              },
              "pattern_timeout": {
                "maxItems": 0
              }
            }
          },
          "counts": {
            "properties": {
              "tsv_skipped_hash_lines": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
