+  "test_source": "import Foundation\n\nvar failures=0\nfunc check(_ ok: Bool,_ name: String) { print((ok ? \"PASS \" : \"FAIL \")+name); if !ok { failures += 1 } }\ncheck(BuildID.parseCommit(\"commit=abc\\ncommit=def\") == nil,\"conflicting identities refused\")\ncheck(BuildID.parseCommit(\"commit=abc\\ncommit=\") == nil,\"later malformed entry refused\")\ncheck(BuildID.parseCommit(\"commit=abc\\ncommit=abc\") == \"abc\",\"same duplicate accepted\")\ncheck(BuildID.parseCommit(\"other=x\\ncommit=abc\") == \"abc\",\"legacy grammar retained\")\n\nfor text in [\"commit=abc\\ncommit=def\",\"commit=def\\ncommit=abc\",\"commit=abc\\ncommit=\",\"commit=\\ncommit=abc\",\"commit=abc\\ncommit=a b\",\"commit=a\\tb\\ncommit=abc\",\"commit=abc\\r\\ncommit=def\",\"commit=abc\\ncommit=abc\\ncommit=def\"] {\n check(BuildID.parseCommit(text) == nil,\"all entries scanned conflicts/malformed fail closed\")\n}\nfor text in [\"commit=abc\",\" commit=abc \",\"\\tcommit= abc\\t\",\"\\ncommit=abc\\r\\ncommit=abc\\r\",\"other=x\\ncommit=abc\\nignored=y\"] {\n check(BuildID.parseCommit(text) == \"abc\",\"legacy whitespace and duplicate grammar\")\n}\nfor opaque in [\"not-a-git-hash\",\"1234567\",\"abc=def\",\"!opaque!?\",\"\u00e7\u0131\u011f\"] {\n check(BuildID.parseCommit(\"commit=\"+opaque+\"\\ncommit=\"+opaque) == opaque,\"opaque identity preserved\")\n}\nfor text in [\"\",\"other=x\",\"commit=\",\"commit=  \",\"Commit=abc\",\"commit =abc\"] {\n check(BuildID.parseCommit(text) == nil,\"no usable exact commit key\")\n}\ncheck(BuildID.shortValue(\"1234567890\") == \"1234567\" && BuildID.shortValue(\"abc\") == \"abc\" && BuildID.shortValue(BuildID.unknown) == \"unknown\",\"short format preserved\")\nlet fixedDate = Date(timeIntervalSince1970: 0)\nlet validTree = String(repeating: \"b\", count: 40)\nlet validBuild = String(repeating: \"a\", count: 64)\nlet knownLine = BuildID.launchLine(value: validBuild, tree: validTree, at: fixedDate)\ncheck(knownLine == \"[GOR] build-id \\(validBuild) tree=\\(validTree) launch=1970-01-01T00:00:00Z\", \"current launchLine exact composition\")\ncheck(BuildID.launchTimestamp(fixedDate) == \"1970-01-01T00:00:00Z\", \"UTC launch timestamp\")\ncheck(BuildID.parseTree(\"tree=\" + validTree) == validTree, \"current tree parser preserved\")\nlet unknownLine = BuildID.launchLine(value: \"\", tree: \"bad tree\", at: fixedDate)\ncheck(unknownLine == \"[GOR] build-id unknown tree=unknown launch=1970-01-01T00:00:00Z\", \"whitespace and empty launch fallback\")\nfor separator in [\"\\r\\n\", \"\\r\", \"\\n\", \"\\u{85}\", \"\\u{2028}\", \"\\u{2029}\"] {\n check(BuildID.parseCommit(\"commit=abc\" + separator + \"commit=def\") == nil, \"all newline conflicts rejected\")\n check(BuildID.parseCommit(\"commit=abc\" + separator + \"commit=abc\") == \"abc\", \"all newline identical duplicates accepted\")\n}\nprint(\"EMITTED:\" + knownLine)\nprint(\"EMITTED:\" + unknownLine)\nlet emptyBundlePath=FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString+\".bundle\")\ntry! FileManager.default.createDirectory(at:emptyBundlePath,withIntermediateDirectories:true)\ndefer { try? FileManager.default.removeItem(at:emptyBundlePath) }\nif let bundle=Bundle(path:emptyBundlePath.path) {check(BuildID.value(bundle:bundle) == BuildID.unknown,\"missing bundle identity unknown\")} else {check(false,\"test bundle created\")}\n\nprint(\"semantic failures=\\(failures)\")\nexit(failures == 0 ? 0 : 1)\n"
