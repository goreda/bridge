diff --git a/archive/gor/Sources/gor/GorRuntimeDump.swift b/archive/gor/Sources/gor/GorRuntimeDump.swift
new file mode 100644
index 000000000..d46908bee
--- /dev/null
+++ b/archive/gor/Sources/gor/GorRuntimeDump.swift
@@ -0,0 +1,197 @@
+// ================================================================
+//  GorRuntimeDump.swift - arch-198k in-app reporter, AppKit adapter
+//  Owns: --gor-dump-runtime=<path> collection: NSApp.mainMenu walk,
+//  panel inventory, mpv IPC reads (script messages / bindings /
+//  glsl-shaders / script-opts), executable SHA256, photon shader
+//  warn/error capture (arch-198l: per-shader buckets, grain separate
+//  from sharp). Pure assembly lives in GorRuntimeDumpCore.swift.
+//  Contract: active only with the flag; normal launch is untouched.
+//  macOS-only (AppKit); Mac not verified in this lane.
+// ================================================================
+#if canImport(AppKit)
+import AppKit
+import CryptoKit
+
+final class GorRuntimeDump {
+    static let outputPath = GorRuntimeDumpCore.outputPath(arguments: CommandLine.arguments)
+    static let requested = outputPath != nil
+
+    private static let lock = NSLock()
+    /// Raw mpv stderr lines (pre-classification; classified at dump time so
+    /// the bucket set can include every generated photon shader name).
+    private static var mpvLines: [String] = []
+    private static let mpvLinesCap = 2000
+    private static var didRun = false
+
+    /// Called from AppDelegate's mpv stderr line handler. Cheap when the
+    /// flag is absent.
+    static func recordMpvLine(_ line: String) {
+        guard requested else { return }
+        lock.lock()
+        if mpvLines.count < mpvLinesCap { mpvLines.append(line) }
+        lock.unlock()
+    }
+
+    /// Install after mpv launch. Polls until the player answers IPC and the
+    /// photon scripts have written their load-time shaders, then dumps once.
+    /// On timeout it dumps anyway with partial=true.
+    static func install(ipcPath: String, configDir: String) {
+        guard requested, !didRun else { return }
+        DispatchQueue.global(qos: .utility).async {
+            let shaderDir = configDir + "/shader"
+            let markers = ["photon-chrome.glsl", "photon-grain.glsl"]
+            var ready = false
+            for _ in 0..<60 {
+                let ipcUp = !IPCClient(path: ipcPath).queryBatch(#"{"command":["get_property","mpv-version"],"request_id":1}"# + "\n", timeout: 0.5).isEmpty
+                let scriptsUp = markers.allSatisfy { FileManager.default.fileExists(atPath: shaderDir + "/" + $0) }
+                if ipcUp && scriptsUp { ready = true; break }
+                Thread.sleep(forTimeInterval: 0.5)
+            }
+            if ready { Thread.sleep(forTimeInterval: 1.0) }  // settle: first PARAM pushes land
+            collect(ipcPath: ipcPath, configDir: configDir, partial: !ready)
+        }
+    }
+
+    private static func collect(ipcPath: String, configDir: String, partial: Bool) {
+        lock.lock()
+        if didRun { lock.unlock(); return }
+        didRun = true
+        let lines = mpvLines
+        lock.unlock()
+
+        let client = IPCClient(path: ipcPath)
+        func ipcGet(_ property: String) -> Any? {
+            let payload = "{\"command\":[\"get_property\",\"" + property + "\"],\"request_id\":1}\n"
+            let replies = client.queryBatch(payload, timeout: 0.8)
+            guard let first = replies.first,
+                  let obj = try? JSONSerialization.jsonObject(with: Data(first.utf8)) as? [String: Any] else { return nil }
+            return obj["data"]
+        }
+
+        // ── IPC reads ──
+        let glslShaders = (ipcGet("glsl-shaders") as? [Any])?.compactMap { $0 as? String } ?? []
+        let shaderNames = glslShaders.map { ($0 as NSString).lastPathComponent }
+        let generatedShaders = ((try? FileManager.default.contentsOfDirectory(atPath: configDir + "/shader")) ?? [])
+            .filter { $0.hasPrefix("photon") && $0.hasSuffix(".glsl") }.sorted()
+        let allShaderNames = Array(Set(shaderNames + generatedShaders)).sorted()
+        let scriptOptions = ipcGet("script-opts") as? [String: Any] ?? [:]
+        let inputBindings: [Any] = {
+            if let native = ipcGet("input-bindings") as? [Any], !native.isEmpty { return native }
+            let confPath = configDir + "/input.conf"
+            guard let text = try? String(contentsOfFile: confPath, encoding: .utf8) else { return [] }
+            return GorRuntimeDumpCore.parseInputConf(text).map { $0 as [String: Any] }
+        }()
+
+        // ── Script messages: the running scripts' registered names (the
+        // scripts directory holds byte-exact what mpv loaded) plus the
+        // script-message-to targets named by input bindings. mpv exposes no
+        // registered-message enumeration over IPC; provenance is recorded.
+        let scriptsDir = configDir + "/scripts"
+        var registered: Set<String> = []
+        if let files = try? FileManager.default.contentsOfDirectory(atPath: scriptsDir) {
+            for file in files where file.hasSuffix(".lua") {
+                if let source = try? String(contentsOfFile: scriptsDir + "/" + file, encoding: .utf8) {
+                    registered.formUnion(GorRuntimeDumpCore.registeredScriptMessages(in: source))
+                }
+            }
+        }
+        var invoked: Set<String> = []
+        if let text = try? String(contentsOfFile: configDir + "/input.conf", encoding: .utf8) {
+            invoked.formUnion(GorRuntimeDumpCore.bindingMessageTargets(in: text))
+        }
+        let scriptMessages: [String: Any] = [
+            "registered": registered.sorted(),
+            "invoked_in_bindings": invoked.sorted(),
+            "source": "scripts-dir-scan+input.conf (mpv exposes no registered-message enumeration over IPC)",
+        ]
+
+        // ── arch-198l: per-shader warn/error buckets (grain vs sharp) ──
+        var buckets: [String: [String]] = [:]
+        for name in allShaderNames { buckets[name] = [] }
+        for line in lines {
+            GorRuntimeDumpCore.appendShaderLogLine(&buckets, line: line, shaderNames: allShaderNames)
+        }
+        let photonShaderLog = buckets.filter { !$0.value.isEmpty }
+
+        // ── Executable identity ──
+        var executableSha = "unavailable"
+        if let exe = Bundle.main.executableURL, let bytes = try? Data(contentsOf: exe) {
+            executableSha = SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+        }
+
+        // ── Menus + panels on the main thread ──
+        DispatchQueue.main.sync {
+            let menus = dumpMenuTree(NSApp.mainMenu)
+            let panels = dumpPanels()
+            let object = GorRuntimeDumpCore.assemble(
+                executableSha256: executableSha,
+                menus: menus,
+                panels: panels,
+                scriptMessages: scriptMessages,
+                inputBindings: inputBindings,
+                shaderNames: allShaderNames,
+                scriptOptions: scriptOptions,
+                photonShaderLog: photonShaderLog,
+                partial: partial)
+            write(object)
+        }
+    }
+
+    private static func dumpMenuTree(_ menu: NSMenu?) -> [Any] {
+        guard let menu else { return [] }
+        return menu.items.map { item -> [String: Any] in
+            var record: [String: Any] = [
+                "title": item.title,
+                "enabled": item.isEnabled,
+                "separator": item.isSeparatorItem,
+                "key_equivalent": item.keyEquivalent,
+                "key_equivalent_modifier_mask": item.keyEquivalentModifierMask.rawValue,
+                "tag": item.tag,
+            ]
+            if let action = item.action { record["action"] = NSStringFromSelector(action) }
+            if let submenu = item.submenu { record["submenu"] = dumpMenuTree(submenu) }
+            return record
+        }
+    }
+
+    /// Panels: the live NSPanel instances plus the static inventory of the
+    /// app's panel features (the app keeps no runtime panel registry; the
+    /// catalog names the panel classes and their owners).
+    private static func dumpPanels() -> [String: Any] {
+        let live = NSApp.windows.filter { $0 is NSPanel }.map { panel -> [String: Any] in
+            [
+                "class": String(describing: type(of: panel)),
+                "title": panel.title,
+                "level": panel.level.rawValue,
+                "visible": panel.isVisible,
+            ]
+        }
+        return [
+            "live": live,
+            "available": [
+                "URLPanel", "FileBrowserPanel", "MusicPanel", "IPTVPanel",
+                "ArchiveBrowserPanel", "MagnetResultsPanel", "MagnetBrowserController",
+                "SpineUI dropdown/HUD panels",
+            ],
+            "note": "no runtime panel registry exists; 'available' is the static class inventory, 'live' the open NSPanel instances at dump time",
+        ]
+    }
+
+    private static func write(_ object: [String: Any]) {
+        guard let path = outputPath, let data = GorRuntimeDumpCore.jsonData(object) else {
+            NSLog("[gor] runtime dump: assembly failed")
+            return
+        }
+        let url = URL(fileURLWithPath: path)
+        let tmp = url.appendingPathExtension("tmp-\(ProcessInfo.processInfo.processIdentifier)")
+        do {
+            try data.write(to: tmp)
+            try? FileManager.default.removeItem(at: url)
+            try FileManager.default.moveItem(at: tmp, to: url)
+            NSLog("[gor] runtime dump written: %@", path)
+        } catch {
+            NSLog("[gor] runtime dump write failed: %@", "\(error)")
+        }
+    }
+}
+#endif
diff --git a/archive/gor/Sources/gor/GorRuntimeDumpCore.swift b/archive/gor/Sources/gor/GorRuntimeDumpCore.swift
new file mode 100644
index 000000000..86d267a72
--- /dev/null
+++ b/archive/gor/Sources/gor/GorRuntimeDumpCore.swift
@@ -0,0 +1,159 @@
+// ================================================================
+//  GorRuntimeDumpCore.swift - arch-198k in-app reporter, pure core
+//  Owns: flag parsing, mpv line classification, payload extraction,
+//        feature-runtime.json assembly (Foundation only; compiles on
+//        Linux so the witness harness can pin behavior). The AppKit
+//        adapter lives in GorRuntimeDump.swift.
+//  Contract: runs only under --gor-dump-runtime=<path>; normal launch
+//  is untouched. Output is deterministic (sorted keys, stable order).
+// ================================================================
+import Foundation
+
+enum GorRuntimeDumpCore {
+    static let flagPrefix = "--gor-dump-runtime="
+
+    /// The dump output path, or nil when the flag is absent (normal launch).
+    static func outputPath(arguments: [String]) -> String? {
+        for arg in arguments where arg.hasPrefix(flagPrefix) {
+            let path = String(arg.dropFirst(flagPrefix.count))
+            if !path.isEmpty { return path }
+        }
+        return nil
+    }
+
+    /// mpv stderr line classifier: keep warn/error lines that concern any
+    /// photon shader (the shader module's own [shader] lines, or any line
+    /// naming a photon shader file). msg-level shader=v is set at launch.
+    static func isPhotonShaderLogLine(_ line: String, shaderNames: [String]) -> Bool {
+        let lowered = line.lowercased()
+        guard lowered.contains("warn") || lowered.contains("error") || lowered.contains("failed") else { return false }
+        if lowered.contains("[shader") { return true }
+        return shaderNames.contains { line.contains($0) }
+    }
+
+    /// arch-198l: bucket one kept line by the shader it names (grain and
+    /// sharp must be separable - the "sometimes no grain" cause is not
+    /// established). Lines naming no shader land in "unattributed".
+    static func shaderLogBucket(_ line: String, shaderNames: [String]) -> String {
+        for name in shaderNames where line.contains(name) { return name }
+        return "unattributed"
+    }
+
+    /// Append a line to per-shader buckets (one bucket per known shader name
+    /// plus "unattributed"), preserving arrival order per bucket.
+    static func appendShaderLogLine(_ buckets: inout [String: [String]], line: String, shaderNames: [String]) {
+        guard isPhotonShaderLogLine(line, shaderNames: shaderNames) else { return }
+        let bucket = shaderLogBucket(line, shaderNames: shaderNames)
+        buckets[bucket, default: []].append(line)
+    }
+
+    /// Names registered via mp.register_script_message("name", ...) in a Lua
+    /// source. The scanned file is the byte-exact script mpv loaded.
+    static func registeredScriptMessages(in luaSource: String) -> [String] {
+        var out: [String] = []
+        for line in luaSource.split(separator: "\n") {
+            // Lua line comments never register anything.
+            if line.drop(while: { $0 == " " || $0 == "\t" }).hasPrefix("--") { continue }
+            var rest = Substring(line)
+            while let range = rest.range(of: "register_script_message(\"") {
+                let after = rest[range.upperBound...]
+                if let end = after.firstIndex(of: "\"") {
+                    out.append(String(after[..<end]))
+                }
+                rest = after
+            }
+        }
+        return out
+    }
+
+    /// script-message-to <target> names appearing in input.conf text.
+    static func bindingMessageTargets(in inputConf: String) -> [String] {
+        var out: [String] = []
+        for line in inputConf.split(separator: "\n") {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if trimmed.isEmpty || trimmed.hasPrefix("#") { continue }
+            var rest = Substring(trimmed)
+            while let range = rest.range(of: "script-message-to ") {
+                var after = rest[range.upperBound...]
+                if after.hasPrefix("\"") { after = after.dropFirst() }
+                let target = after.split(whereSeparator: { $0 == " " || $0 == "\"" }).first.map(String.init)
+                if let target { out.append(target) }
+                rest = after
+            }
+        }
+        return out
+    }
+
+    /// input.conf parse (IPC input-bindings fallback): key + full command,
+    /// comments and blank lines skipped, inline order preserved.
+    static func parseInputConf(_ text: String) -> [[String: String]] {
+        var out: [[String: String]] = []
+        for line in text.split(separator: "\n") {
+            let trimmed = line.trimmingCharacters(in: .whitespaces)
+            if trimmed.isEmpty || trimmed.hasPrefix("#") { continue }
+            let parts = trimmed.split(maxSplits: 1, whereSeparator: { $0 == " " || $0 == "\t" })
+            guard let key = parts.first else { continue }
+            let command = parts.count > 1 ? parts[1].trimmingCharacters(in: .whitespaces) : ""
+            out.append(["key": String(key), "command": command])
+        }
+        return out
+    }
+
+    /// The photon_v4_replacement section: checker-side comparison fields are
+    /// emitted in schema shape with NOT_RUN placeholders (arch-198k; the
+    /// reporter records the build, the bridge checker compares it).
+    static func photonV4ReplacementSection(executableSha256: String) -> [String: Any] {
+        return [
+            "executable_sha256": executableSha256,
+            "result": "NOT_RUN",
+            "lua_swift_twin_byte_equal": NSNull(),
+            "v7_invariants": [String](),
+            "manual_recall_sequence": "NOT_RUN",
+            "implemented": [
+                "V1": false, "V2": false, "V3": false, "V4": false,
+                "V5": false, "V6": false, "V7": false,
+            ],
+            "note": "checker-side fields emitted in schema shape only (arch-198k); filled by the bridge checker",
+        ]
+    }
+
+    /// Assemble the full feature-runtime object. Every collection is passed
+    /// in by the adapter so the assembly is platform-free and testable.
+    static func assemble(
+        executableSha256: String,
+        menus: [Any],
+        panels: [String: Any],
+        scriptMessages: [String: Any],
+        inputBindings: [Any],
+        shaderNames: [String],
+        scriptOptions: [String: Any],
+        photonShaderLog: [String: [String]],
+        partial: Bool
+    ) -> [String: Any] {
+        return [
+            "schema": "feature-runtime/1 (arch-198k)",
+            "partial": partial,
+            "executable_sha256": executableSha256,
+            "features": [
+                "menus": menus,
+                "panels": panels,
+                "script_messages": scriptMessages,
+                "input_bindings": inputBindings,
+                "shader_names": shaderNames,
+                "script_options": scriptOptions,
+            ],
+            "photon_shader_log": photonShaderLog,
+            "photon_v4_replacement": photonV4ReplacementSection(executableSha256: executableSha256),
+        ]
+    }
+
+    /// Deterministic JSON: sorted keys, pretty printed, trailing newline.
+    static func jsonData(_ object: [String: Any]) -> Data? {
+        guard JSONSerialization.isValidJSONObject(object),
+              var data = try? JSONSerialization.data(withJSONObject: object, options: [.prettyPrinted, .sortedKeys]) else {
+            return nil
+        }
+        data.append(0x0A)
+        return data
+    }
+}
diff --git a/archive/gor/Tests/Harness/RuntimeDump/run.sh b/archive/gor/Tests/Harness/RuntimeDump/run.sh
new file mode 100755
index 000000000..ee1824488
--- /dev/null
+++ b/archive/gor/Tests/Harness/RuntimeDump/run.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# arch-198k runtime-dump core witness: compile core+suite, expect FAILS 0
+# (same GorFit harness pattern as Tests/Harness/HDRHandoff).
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+WORK="$(mktemp -d /tmp/gor-runtime-dump-witness.XXXXXX)"
+swiftc -O "$HERE/../../../Sources/gor/GorRuntimeDumpCore.swift" "$HERE/suite/main.swift" \
+  -o "$WORK/runtime-dump-witness" 2>"$WORK/build.log"
+if [ $? -ne 0 ]; then
+  echo "BUILD FAIL"; cat "$WORK/build.log"; exit 1
+fi
+"$WORK/runtime-dump-witness" | tee "$WORK/run.log"
+grep -q '^FAILS 0$' "$WORK/run.log"
+RC=$?
+if [ $RC -eq 0 ]; then
+  echo "PASS: runtime dump core witness; logs retained at $WORK"
+else
+  echo "FAIL: runtime dump core witness; logs retained at $WORK"
+fi
+exit $RC
diff --git a/archive/gor/Tests/Harness/RuntimeDump/suite/main.swift b/archive/gor/Tests/Harness/RuntimeDump/suite/main.swift
new file mode 100644
index 000000000..f98293b2e
--- /dev/null
+++ b/archive/gor/Tests/Harness/RuntimeDump/suite/main.swift
@@ -0,0 +1,89 @@
+// arch-198k/198l runtime-dump core witness (GorFit harness pattern:
+// swiftc -O core+suite, expect FAILS 0). Pins the pure behavior of
+// GorRuntimeDumpCore: flag parsing, mpv line classification with per-shader
+// buckets (grain separate from sharp), Lua message extraction, input.conf
+// parsing, deterministic assembly.
+import Foundation
+
+var fails = 0
+func check(_ cond: Bool, _ label: String) {
+    if !cond { fails += 1; print("FAIL: \(label)") }
+}
+
+// ── flag parsing ──
+check(GorRuntimeDumpCore.outputPath(arguments: ["gor", "--gor-dump-runtime=/tmp/out.json"]) == "/tmp/out.json", "flag path")
+check(GorRuntimeDumpCore.outputPath(arguments: ["gor", "--other"]) == nil, "flag absent")
+check(GorRuntimeDumpCore.outputPath(arguments: ["gor", "--gor-dump-runtime="]) == nil, "empty path rejected")
+check(GorRuntimeDumpCore.outputPath(arguments: ["gor"]) == nil, "normal launch untouched")
+
+// ── mpv line classification + per-shader buckets (arch-198l) ──
+let shaders = ["photon-grain.glsl", "photon-sharp.glsl", "photon-chrome.glsl"]
+check(GorRuntimeDumpCore.isPhotonShaderLogLine("[shader] warn: photon-grain.glsl: some warning", shaderNames: shaders), "grain warn kept")
+check(GorRuntimeDumpCore.isPhotonShaderLogLine("[shader] error: failed to compile photon-sharp.glsl", shaderNames: shaders), "sharp error kept")
+check(!GorRuntimeDumpCore.isPhotonShaderLogLine("[shader] info: loaded photon-grain.glsl", shaderNames: shaders), "info dropped")
+check(!GorRuntimeDumpCore.isPhotonShaderLogLine("[ffmpeg] error: decode failed", shaderNames: shaders), "non-shader error dropped")
+check(GorRuntimeDumpCore.shaderLogBucket("[shader] warn: photon-grain.glsl: x", shaderNames: shaders) == "photon-grain.glsl", "grain bucketed as grain")
+check(GorRuntimeDumpCore.shaderLogBucket("[shader] error: photon-sharp.glsl failed", shaderNames: shaders) == "photon-sharp.glsl", "sharp bucketed as sharp")
+check(GorRuntimeDumpCore.shaderLogBucket("[shader] warn: generic", shaderNames: shaders) == "unattributed", "unnamed line unattributed")
+
+var buckets: [String: [String]] = [:]
+for s in shaders { buckets[s] = [] }
+GorRuntimeDumpCore.appendShaderLogLine(&buckets, line: "[shader] warn: photon-grain.glsl: g1", shaderNames: shaders)
+GorRuntimeDumpCore.appendShaderLogLine(&buckets, line: "[shader] error: photon-sharp.glsl: s1", shaderNames: shaders)
+GorRuntimeDumpCore.appendShaderLogLine(&buckets, line: "[shader] warn: photon-grain.glsl: g2", shaderNames: shaders)
+GorRuntimeDumpCore.appendShaderLogLine(&buckets, line: "[shader] info: noise", shaderNames: shaders)
+check(buckets["photon-grain.glsl"]?.count == 2, "grain bucket has 2, order kept")
+check(buckets["photon-grain.glsl"]?[0].hasSuffix("g1") == true && buckets["photon-grain.glsl"]?[1].hasSuffix("g2") == true, "grain bucket order")
+check(buckets["photon-sharp.glsl"]?.count == 1, "sharp bucket separate from grain")
+check(buckets["photon-chrome.glsl"]?.isEmpty == true, "chrome bucket empty")
+
+// ── Lua registered-message extraction ──
+let lua = """
+mp.register_script_message("photon-scene-feed", function(payload)
+mp.register_script_message("photon-chrome-toggle", function()
+-- mp.register_script_message("commented-out", handler)
+"""
+let msgs = GorRuntimeDumpCore.registeredScriptMessages(in: lua)
+check(msgs == ["photon-scene-feed", "photon-chrome-toggle"], "registered messages extracted, got \(msgs)")
+
+// ── input.conf parsing ──
+let conf = """
+# comment
+c script-message-to photon_chrome photon-chrome-toggle
+C script-message-to photon_chrome photon-chrome-filter-toggle
+
+F9 script-message-to photon toggle
+"""
+let bindings = GorRuntimeDumpCore.parseInputConf(conf)
+check(bindings.count == 3, "3 bindings parsed, got \(bindings.count)")
+check(bindings[0]["key"] == "c" && bindings[0]["command"] == "script-message-to photon_chrome photon-chrome-toggle", "binding 0")
+let targets = GorRuntimeDumpCore.bindingMessageTargets(in: conf)
+check(targets == ["photon_chrome", "photon_chrome", "photon"], "binding targets, got \(targets)")
+
+// ── deterministic assembly ──
+let object = GorRuntimeDumpCore.assemble(
+    executableSha256: "deadbeef",
+    menus: [["title": "app", "enabled": true]],
+    panels: ["live": [Any](), "available": ["URLPanel"]],
+    scriptMessages: ["registered": ["a", "b"], "invoked_in_bindings": ["a"], "source": "test"],
+    inputBindings: [["key": "c", "command": "script-message-to photon_chrome photon-chrome-toggle"]],
+    shaderNames: shaders,
+    scriptOptions: ["photon-scriptdir": "/x"],
+    photonShaderLog: ["photon-grain.glsl": ["[shader] warn: g1"]],
+    partial: false)
+guard let d1 = GorRuntimeDumpCore.jsonData(object), let d2 = GorRuntimeDumpCore.jsonData(object),
+      let s1 = String(data: d1, encoding: .utf8) else {
+    fails += 1; print("FAIL: jsonData nil")
+    print("FAILS \(fails)")
+    exit(1)
+}
+check(d1 == d2, "assembly deterministic")
+check(s1.hasSuffix("}\n"), "trailing newline")
+check(s1.contains("\"executable_sha256\" : \"deadbeef\""), "executable sha present")
+check(s1.contains("\"photon_v4_replacement\""), "v4 section present")
+check(s1.contains("\"photon_shader_log\""), "per-shader log section present")
